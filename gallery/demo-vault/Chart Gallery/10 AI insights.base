views:
  -
    type: "chart-ai"
    name: "Focus rhythm"
    echarts-option:
      animation: false
      backgroundColor: "#ffffff"
      textStyle:
        fontFamily: "-apple-system, BlinkMacSystemFont, Segoe UI, sans-serif"
        color: "#373b3b"
      title:
        text: "A season of focused work"
        subtext: "Hours by day  /  July - September 2026"
        left: 28
        top: 24
        textStyle:
          fontSize: 24
          fontWeight: 600
          color: "#303635"
        subtextStyle:
          fontSize: 13
          color: "#727b78"
        itemGap: 12
      grid:
        left: 88
        right: 40
        top: 126
        bottom: 96
      tooltip:
        position: "top"
        confine: true
      xAxis:
        type: "category"
        data: ["Jul 06", "Jul 13", "Jul 20", "Jul 27", "Aug 03", "Aug 10", "Aug 17", "Aug 24", "Aug 31", "Sep 07", "Sep 14", "Sep 21"]
        splitArea:
          show: false
        axisLine:
          show: false
        axisTick:
          show: false
        axisLabel:
          color: "#727b78"
          margin: 14
          fontSize: 12
      yAxis:
        type: "category"
        data: ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
        inverse: true
        axisLine:
          show: false
        axisTick:
          show: false
        axisLabel:
          color: "#727b78"
          margin: 16
          fontSize: 12
      visualMap:
        min: 0
        max: 13
        calculable: false
        orient: "horizontal"
        left: "center"
        bottom: 22
        itemWidth: 12
        itemHeight: 200
        text: ["More focus", "Less focus"]
        textStyle:
          color: "#727b78"
          fontSize: 12
        inRange:
          color: ["#f0f4ef", "#d1dfd2", "#9ebeb0", "#679b90", "#3d726e"]
      series:
        -
          name: "Focus hours"
          type: "heatmap"
