views:
  -
    type: "chart-ai"
    name: "Reference library"
    echarts-option:
      animation: false
      backgroundColor: "transparent"
      color: ["#4876bd", "#8a73b8", "#3e9690", "#759b67", "#bf8f55", "#a7afbd"]
      textStyle:
        color: "#344052"
        fontSize: 12
      aria:
        enabled: true
        label:
          description: "A fictional reference library of 619 papers, organized into six research collections by publication year from 2014 through 2026."
      title:
        text: "Reference library"
        subtext: "619 papers  /  publication year & collection"
        left: "center"
        top: 14
        itemGap: 8
        textStyle:
          fontSize: 22
          fontWeight: 600
          color: "#344052"
        subtextStyle:
          fontSize: 12
          color: "#788394"
      grid:
        left: 48
        right: 26
        top: 94
        bottom: 120
      tooltip:
        trigger: "axis"
        confine: true
        order: "valueDesc"
        backgroundColor: "#ffffff"
        borderColor: "#dce3eb"
        borderWidth: 1
        padding: [10, 12]
        textStyle:
          color: "#344052"
          fontSize: 12
        axisPointer:
          type: "line"
          lineStyle:
            type: "dashed"
            width: 1
            color: "#788394"
      xAxis:
        type: "category"
        data: ["2014", "2015", "2016", "2017", "2018", "2019", "2020", "2021", "2022", "2023", "2024", "2025", "2026"]
        boundaryGap: false
        axisLine:
          lineStyle:
            color: "#dce3eb"
        axisTick:
          show: false
        axisLabel:
          color: "#788394"
          fontSize: 11
          margin: 12
        splitLine:
          show: false
      yAxis:
        type: "value"
        min: 0
        max: 40
        interval: 10
        name: "Papers"
        nameGap: 18
        nameTextStyle:
          color: "#788394"
          fontSize: 11
          align: "right"
          padding: [0, 8, 0, 0]
        axisLine:
          show: false
        axisTick:
          show: false
        axisLabel:
          color: "#788394"
          fontSize: 11
          margin: 12
        splitLine:
          show: true
          lineStyle:
            color: "#e9edf2"
            type: "dashed"
            width: 1
      legend:
        left: "center"
        bottom: 70
        data: ["Vector search", "Language models", "Data systems", "Cloud computing", "Research methods", "Other"]
        icon: "roundRect"
        itemWidth: 14
        itemHeight: 3
        itemGap: 19
        textStyle:
          fontSize: 11
          color: "#788394"
        inactiveColor: "#cdd3dc"
        selectedMode: true
      dataZoom:
        -
          type: "slider"
          xAxisIndex: 0
          start: 0
          end: 100
          left: 48
          right: 26
          bottom: 22
          height: 24
          showDetail: false
          showDataShadow: true
          brushSelect: false
          moveHandleSize: 0
          borderColor: "#dce3eb"
          backgroundColor: "#f4f6fa"
          fillerColor: "rgba(72,118,189,0.08)"
          handleSize: "86%"
          handleStyle:
            color: "#4876bd"
            borderWidth: 0
          dataBackground:
            lineStyle:
              color: "#788394"
              opacity: 0.3
            areaStyle:
              color: "#788394"
              opacity: 0.05
          selectedDataBackground:
            lineStyle:
              color: "#4876bd"
              opacity: 0.65
              width: 1
            areaStyle:
              color: "#4876bd"
              opacity: 0.08
        -
          type: "inside"
          xAxisIndex: 0
          start: 0
          end: 100
          zoomOnMouseWheel: "ctrl"
          moveOnMouseWheel: false
      series:
        -
          name: "Vector search"
          type: "line"
          data: [1, 2, 2, 3, 4, 5, 8, 10, 13, 18, 24, 29, 27]
          smooth: 0.32
          smoothMonotone: "x"
          symbol: "circle"
          symbolSize: 6
          showSymbol: false
          lineStyle:
            width: 2.25
            color: "#4876bd"
          itemStyle:
            color: "#4876bd"
          areaStyle:
            color:
              type: "linear"
              x: 0
              y: 0
              x2: 0
              y2: 1
              colorStops:
                -
                  offset: 0
                  color: "rgba(72, 118, 189, 0.12)"
                -
                  offset: 1
                  color: "rgba(72, 118, 189, 0.015)"
          emphasis:
            focus: "series"
            lineStyle:
              width: 3
        -
          name: "Language models"
          type: "line"
          data: [0, 0, 1, 1, 2, 2, 4, 5, 8, 17, 29, 38, 34]
          smooth: 0.32
          smoothMonotone: "x"
          symbol: "circle"
          symbolSize: 6
          showSymbol: false
          lineStyle:
            width: 2.25
            color: "#8a73b8"
          itemStyle:
            color: "#8a73b8"
          areaStyle:
            color:
              type: "linear"
              x: 0
              y: 0
              x2: 0
              y2: 1
              colorStops:
                -
                  offset: 0
                  color: "rgba(138, 115, 184, 0.12)"
                -
                  offset: 1
                  color: "rgba(138, 115, 184, 0.015)"
          emphasis:
            focus: "series"
            lineStyle:
              width: 3
        -
          name: "Data systems"
          type: "line"
          data: [3, 4, 4, 5, 6, 7, 8, 10, 12, 14, 17, 20, 22]
          smooth: 0.32
          smoothMonotone: "x"
          symbol: "circle"
          symbolSize: 6
          showSymbol: false
          lineStyle:
            width: 2.25
            color: "#3e9690"
          itemStyle:
            color: "#3e9690"
          areaStyle:
            color:
              type: "linear"
              x: 0
              y: 0
              x2: 0
              y2: 1
              colorStops:
                -
                  offset: 0
                  color: "rgba(62, 150, 144, 0.12)"
                -
                  offset: 1
                  color: "rgba(62, 150, 144, 0.015)"
          emphasis:
            focus: "series"
            lineStyle:
              width: 3
        -
          name: "Cloud computing"
          type: "line"
          data: [1, 1, 2, 2, 3, 4, 4, 5, 7, 9, 12, 15, 14]
          smooth: 0.32
          smoothMonotone: "x"
          symbol: "circle"
          symbolSize: 6
          showSymbol: false
          lineStyle:
            width: 2.25
            color: "#759b67"
          itemStyle:
            color: "#759b67"
          areaStyle:
            color:
              type: "linear"
              x: 0
              y: 0
              x2: 0
              y2: 1
              colorStops:
                -
                  offset: 0
                  color: "rgba(117, 155, 103, 0.12)"
                -
                  offset: 1
                  color: "rgba(117, 155, 103, 0.015)"
          emphasis:
            focus: "series"
            lineStyle:
              width: 3
        -
          name: "Research methods"
          type: "line"
          data: [2, 2, 3, 3, 3, 4, 4, 5, 6, 7, 9, 10, 9]
          smooth: 0.32
          smoothMonotone: "x"
          symbol: "circle"
          symbolSize: 6
          showSymbol: false
          lineStyle:
            width: 2.25
            color: "#bf8f55"
          itemStyle:
            color: "#bf8f55"
          areaStyle:
            color:
              type: "linear"
              x: 0
              y: 0
              x2: 0
              y2: 1
              colorStops:
                -
                  offset: 0
                  color: "rgba(191, 143, 85, 0.12)"
                -
                  offset: 1
                  color: "rgba(191, 143, 85, 0.015)"
          emphasis:
            focus: "series"
            lineStyle:
              width: 3
        -
          name: "Other"
          type: "line"
          data: [1, 2, 1, 2, 3, 3, 3, 4, 5, 6, 8, 9, 7]
          smooth: 0.32
          smoothMonotone: "x"
          symbol: "circle"
          symbolSize: 6
          showSymbol: false
          lineStyle:
            width: 2.25
            color: "#a7afbd"
          itemStyle:
            color: "#a7afbd"
          areaStyle:
            color:
              type: "linear"
              x: 0
              y: 0
              x2: 0
              y2: 1
              colorStops:
                -
                  offset: 0
                  color: "rgba(167, 175, 189, 0.12)"
                -
                  offset: 1
                  color: "rgba(167, 175, 189, 0.015)"
          emphasis:
            focus: "series"
            lineStyle:
              width: 3
      media:
        -
          query:
            maxHeight: 400
          option:
            title:
              top: 8
              itemGap: 6
              textStyle:
                fontSize: 18
              subtextStyle:
                fontSize: 11
            grid:
              top: 78
              bottom: 92
            legend:
              bottom: 48
            dataZoom:
              -
                bottom: 12
                height: 20
              - {}
        -
          query:
            maxWidth: 680
          option:
            title:
              textStyle:
                fontSize: 18
              subtextStyle:
                fontSize: 11
            grid:
              left: 40
              right: 20
              bottom: 118
            legend:
              left: "center"
              bottom: 48
              itemGap: 12
              textStyle:
                fontSize: 10
              data: ["Vector search", "Language models", "Data systems", "\n", "Cloud computing", "Research methods", "Other"]
            dataZoom:
              -
                left: 40
                right: 20
              - {}
